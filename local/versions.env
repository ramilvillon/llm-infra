# local/versions.env
# Populated from upstream on 2026-08-24. Re-run local/test/02-versions.sh after any bump.
#
# Discovery commands (see local/test/02-versions.sh):
#   helm search repo llm-d-infra/llm-d-infra --versions | head
#   helm search repo llm-d-modelservice/llm-d-modelservice --versions | head
#   helm search repo prometheus-community/kube-prometheus-stack --versions | head
#   helm search repo community-charts/mlflow --versions | head
#   helm search repo argo/argo-cd --versions | head
#   gh api repos/<org>/<repo>/releases/latest --jq .tag_name
#
# The `v` prefix is NOT consistent across variables - each follows its own
# upstream project's tag convention. Do not add or strip it downstream;
# use each value exactly as pinned here.
export GATEWAY_API_VERSION=v1.6.1          # gh api repos/kubernetes-sigs/gateway-api/releases/latest
export GAIE_VERSION=v1.6.0                 # gh api repos/kubernetes-sigs/gateway-api-inference-extension/releases/latest
export ISTIO_VERSION=1.30.3                # gh api repos/istio/istio/releases/latest - no v prefix
export INFERENCE_SIM_VERSION=v0.10.2       # gh api repos/llm-d/llm-d-inference-sim/releases/latest
export LLM_D_INFRA_CHART_VERSION=v1.4.0    # helm search repo llm-d-infra/llm-d-infra --versions (gateway/ingress only)
export LLM_D_MODELSERVICE_CHART_VERSION=v0.4.16  # helm search repo llm-d-modelservice/llm-d-modelservice --versions (prefill/decode pools)
# The chart version does NOT track the GAIE API version above (GAIE API is
# v1.6.0; this chart is v1.0.1) - they are versioned independently.
export INFERENCEPOOL_CHART_VERSION=v1.0.1  # oci://registry.k8s.io/gateway-api-inference-extension/charts/inferencepool (InferencePool + EPP scheduler)
export KUBE_PROM_STACK_VERSION=88.5.4      # helm search repo prometheus-community/kube-prometheus-stack --versions - no v prefix
export MLFLOW_CHART_VERSION=1.11.5         # helm search repo community-charts/mlflow --versions - no v prefix
export ARGOCD_CHART_VERSION=10.4.0         # helm search repo argo/argo-cd --versions - no v prefix
# The four ArgoCD Applications' $values git source reads this branch/ref, NOT a
# chart version - it was hardcoded to "phase-0-local-stack" before this fix,
# which breaks on merge: if the branch is deleted ArgoCD goes ComparisonError;
# if it's kept, every Application syncs a frozen feature branch forever and
# future edits to charts/ do NOTHING, silently (the worse failure mode). Set to
# "main" (no v prefix, it's a ref not a tag) ahead of the merge that lands this
# fix on main. CAUTION: until this branch is actually merged, main does not yet
# contain this work, so re-running `make up` against the live cluster with this
# value will point ArgoCD's Applications at a ref that doesn't have the
# expected charts/ paths and break sync. Do not re-apply the Application
# manifests until after merge.
export GIT_REVISION=main   # no v prefix
# Pinned to the node image of the kind cluster this stack was verified against
# (`docker inspect <control-plane> --format '{{.Config.Image}}'` /
# `kubectl version` -> Server v1.36.1). Reproducible bring-up is this stack's
# whole thesis; an unpinned kind node image means the k8s version floats with
# whatever `kind` binary happens to be installed.
export KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5
