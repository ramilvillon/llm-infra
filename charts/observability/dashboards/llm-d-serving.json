{
  "uid": "llm-d-serving",
  "title": "llm-d Serving",
  "description": "Prefill/decode pool signals that decide production GPU sizing: TTFT, TPOT, queue depth, and KV cache utilisation, broken down by pool.",
  "tags": ["llm-d"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "TTFT p95 by pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, llm_d_ai_role) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{llm_d_ai_role}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "TPOT p95 by pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, llm_d_ai_role) (rate(vllm:time_per_output_token_seconds_bucket[5m])))",
          "legendFormat": "{{llm_d_ai_role}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Queue depth by pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (llm_d_ai_role) (vllm:num_requests_waiting)",
          "legendFormat": "{{llm_d_ai_role}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "KV cache utilisation by pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg by (llm_d_ai_role) (vllm:kv_cache_usage_perc)",
          "legendFormat": "{{llm_d_ai_role}}",
          "refId": "A"
        }
      ]
    }
  ]
}
